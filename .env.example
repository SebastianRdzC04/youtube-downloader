# Nextcloud WebDAV — copy to .env and fill in
NEXTCLOUD_URL=https://nube.devas.sbs
NEXTCLOUD_USER=devas
NEXTCLOUD_PASS=__FILL_IN__
NEXTCLOUD_BASE_DIR=devastation/descagas/musica

# API
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=youtube-downloader

# CORS (CLI runs from same host, but leave permissive for the optional web UI)
CORS_ORIGINS=*

# Optional: yt-dlp cookies file (bind-mount ./cookies.txt if YouTube rate-limits)
COOKIES_FILE=
